# Token del bot creato con BotFather.
TELEGRAM_BOT_TOKEN=INSERISCI_IL_TOKEN

# ID numerico Telegram dell'amministratore principale.
SUPER_ADMIN_TELEGRAM_ID=INSERISCI_IL_TUO_ID

# Docker Compose usa questi valori per PostgreSQL.
# Per un database esterno, sostituisci DATABASE_URL con la relativa stringa.
POSTGRES_DB=telegram_bot
POSTGRES_USER=telegram_bot
POSTGRES_PASSWORD=cambia-questa-password
DATABASE_URL=postgresql://telegram_bot:cambia-questa-password@db:5432/telegram_bot

NODE_ENV=production
LOG_LEVEL=info
